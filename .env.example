# Endpoint that the contact form posts JSON to.
# In production, point this at your serverless function (Resend, Postmark, etc.)
# See CONTACT_INTEGRATION.md for the request shape and provider snippets.
VITE_CONTACT_ENDPOINT=/api/contact

# Server-only contact delivery settings (do not prefix with VITE_).
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_FROM_EMAIL=Gridhouse Digital <intake@gridhouse.digital>
CONTACT_TO_EMAIL=hello@gridhouse.digital
# Optional comma-separated origins in addition to the deployed request host.
CONTACT_ALLOWED_ORIGINS=https://gridhouse.digital,https://www.gridhouse.digital

# Sanity CMS — Insights blog
# Get your project ID from https://sanity.io/manage
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production
