# Endpoint that the contact form posts JSON to.
# In production, point this at your serverless function (Resend, Postmark, etc.)
# See CONTACT_INTEGRATION.md for the request shape and provider snippets.
VITE_CONTACT_ENDPOINT=/api/contact

